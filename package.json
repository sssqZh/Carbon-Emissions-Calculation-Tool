{
  "name": "carbon-calculator-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:api": "node server/index.mjs",
    "db:init": "node scripts/init-db.mjs",
    "db:reset": "node scripts/init-db.mjs --reset",
    "build": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:create": "wrangler d1 create carbon-db",
    "db:migrate:local": "wrangler d1 execute carbon-db --local --file=migrations/0001_initial.sql",
    "db:migrate:remote": "wrangler d1 execute carbon-db --remote --file=migrations/0001_initial.sql"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250517.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.50.0"
  }
}
